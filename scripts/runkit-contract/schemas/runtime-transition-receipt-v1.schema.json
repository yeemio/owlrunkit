{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/runtime-transition-receipt-v1.schema.json",
  "title": "OwlCoda RunKit Runtime Transition Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "quickReceipt",
    "runtimeReport",
    "reportingBasis",
    "workspaceMutation",
    "externalMutation",
    "rollbackPerformed",
    "finalExternalState",
    "failedStage",
    "lastPassedStage",
    "rollbackOutcome",
    "stages",
    "recoveryEvidence",
    "transitionDecision",
    "proven",
    "notProven",
    "createdAt",
    "authorizationGranted",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitRuntimeTransitionReceiptV1" },
    "receiptId": { "$ref": "#/$defs/id" },
    "quickReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "path", "sha256"],
      "properties": {
        "receiptId": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "runtimeReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "reportingBasis": { "const": "exact_command_report" },
    "workspaceMutation": { "enum": ["changed", "unchanged"] },
    "externalMutation": { "enum": ["changed", "unchanged", "unknown"] },
    "rollbackPerformed": { "type": "boolean" },
    "finalExternalState": { "$ref": "#/$defs/finalState" },
    "failedStage": { "$ref": "#/$defs/nullableStageId" },
    "lastPassedStage": { "$ref": "#/$defs/nullableStageId" },
    "rollbackOutcome": { "enum": ["not_required", "succeeded", "failed", "unknown"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/stage" }
    },
    "recoveryEvidence": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/recoveryEvidence" }
    },
    "transitionDecision": {
      "enum": [
        "external_transition_passed",
        "external_transition_failed_recovered",
        "external_transition_failed_unrecovered",
        "external_transition_indeterminate",
        "external_transition_invalidated"
      ]
    },
    "proven": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/summary" }
    },
    "notProven": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/summary" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "authorizationGranted": { "const": false },
    "receiptSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hashOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/hash" }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "stageId": { "$ref": "#/$defs/id" },
    "nullableStageId": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/stageId" }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^\\.owlcoda/runkit/quick/receipts/[^/]+/[^/]+$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000]+$"
    },
    "finalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stateRef", "fingerprint", "summary"],
      "properties": {
        "status": { "enum": ["changed", "unchanged", "restored", "unknown"] },
        "stateRef": { "$ref": "#/$defs/reference" },
        "fingerprint": { "$ref": "#/$defs/hashOrNull" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "status", "summary", "evidenceRefs"],
      "properties": {
        "stageId": { "$ref": "#/$defs/stageId" },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "summary": { "$ref": "#/$defs/summary" },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "capturedBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "stateRef", "fingerprint"],
      "properties": {
        "stageId": { "$ref": "#/$defs/stageId" },
        "stateRef": { "$ref": "#/$defs/reference" },
        "fingerprint": { "$ref": "#/$defs/hashOrNull" }
      }
    },
    "restoresTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateRef", "fingerprint"],
      "properties": {
        "stateRef": { "$ref": "#/$defs/reference" },
        "fingerprint": { "$ref": "#/$defs/hashOrNull" }
      }
    },
    "recoveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "capturedBefore", "restoresTo"],
      "properties": {
        "artifactRef": { "$ref": "#/$defs/reference" },
        "capturedBefore": { "$ref": "#/$defs/capturedBefore" },
        "restoresTo": { "$ref": "#/$defs/restoresTo" }
      }
    }
  }
}
