{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/external-runtime-report-v1.schema.json",
  "title": "OwlCoda RunKit External Runtime Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "externalMutation",
    "rollbackPerformed",
    "finalExternalState",
    "failedStage",
    "lastPassedStage",
    "rollbackOutcome",
    "stages",
    "recoveryEvidence",
    "authorizationGranted"
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitExternalRuntimeReportV1" },
    "externalMutation": { "enum": ["changed", "unchanged", "unknown"] },
    "rollbackPerformed": { "type": "boolean" },
    "finalExternalState": { "$ref": "#/$defs/finalState" },
    "failedStage": { "$ref": "#/$defs/nullableStageId" },
    "lastPassedStage": { "$ref": "#/$defs/nullableStageId" },
    "rollbackOutcome": { "enum": ["not_required", "succeeded", "failed", "unknown"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/stage" }
    },
    "recoveryEvidence": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/recoveryEvidence" }
    },
    "authorizationGranted": { "const": false }
  },
  "$defs": {
    "hashOrNull": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "stageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nullableStageId": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/stageId" }
      ]
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000]+$"
    },
    "finalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stateRef", "fingerprint", "summary"],
      "properties": {
        "status": { "enum": ["changed", "unchanged", "restored", "unknown"] },
        "stateRef": { "$ref": "#/$defs/reference" },
        "fingerprint": { "$ref": "#/$defs/hashOrNull" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "status", "summary", "evidenceRefs"],
      "properties": {
        "stageId": { "$ref": "#/$defs/stageId" },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "summary": { "$ref": "#/$defs/summary" },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "capturedBefore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "stateRef", "fingerprint"],
      "properties": {
        "stageId": { "$ref": "#/$defs/stageId" },
        "stateRef": { "$ref": "#/$defs/reference" },
        "fingerprint": { "$ref": "#/$defs/hashOrNull" }
      }
    },
    "restoresTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateRef", "fingerprint"],
      "properties": {
        "stateRef": { "$ref": "#/$defs/reference" },
        "fingerprint": { "$ref": "#/$defs/hashOrNull" }
      }
    },
    "recoveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "capturedBefore", "restoresTo"],
      "properties": {
        "artifactRef": { "$ref": "#/$defs/reference" },
        "capturedBefore": { "$ref": "#/$defs/capturedBefore" },
        "restoresTo": { "$ref": "#/$defs/restoresTo" }
      }
    }
  }
}
