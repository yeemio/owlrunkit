{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/visual-smoke-result-v1.json",
  "title": "OwlCoda RunKit Visual Smoke Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "viewport", "assertions", "console", "navigations", "outputArtifacts"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitVisualSmokeResultV1" },
    "status": { "enum": ["passed", "failed"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "exceptions"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "exceptions": { "type": "integer", "minimum": 0 }
      }
    },
    "navigations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "external"],
        "properties": {
          "protocol": { "type": "string", "minLength": 1 },
          "external": { "type": "boolean" }
        }
      }
    },
    "outputArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
