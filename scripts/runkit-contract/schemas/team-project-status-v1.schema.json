{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.com/schemas/runkit/team-project-status-v1.schema.json",
  "title": "OwlCoda RunKit Team Project Status V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "projectId", "objective", "overall", "counts", "milestones", "workstreams", "workItems", "agents", "readyQueue", "criticalWorkItems", "openDecisions", "resolvedDecisions", "deferredVerifications", "openDeferredVerificationIds", "integrationGates", "dataCandidates", "projectTruthHash", "authorizationGranted", "headline", "dominantGap", "nextAction", "nextActorId", "exitCode"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitTeamProjectStatusV1" },
    "status": { "const": "team_project_status" },
    "projectId": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "overall": { "enum": ["planned", "active", "active_with_blockers", "completed"] },
    "counts": { "type": "object" },
    "milestones": { "type": "array", "items": { "type": "object" } },
    "workstreams": { "type": "array", "items": { "type": "object" } },
    "workItems": { "type": "array", "items": { "type": "object" } },
    "agents": { "type": "array", "items": { "type": "object" } },
    "readyQueue": { "type": "array", "items": { "type": "string" } },
    "criticalWorkItems": { "type": "array", "items": { "type": "string" } },
    "openDecisions": { "type": "array", "items": { "type": "object" } },
    "resolvedDecisions": { "type": "array", "items": { "type": "object" } },
    "deferredVerifications": { "type": "array", "items": { "type": "object" } },
    "openDeferredVerificationIds": { "type": "array", "items": { "type": "string" } },
    "integrationGates": { "type": "array", "items": { "type": "object" } },
    "dataCandidates": { "type": "array", "items": { "type": "object" } },
    "projectTruthHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorizationGranted": { "const": false },
    "headline": { "type": "string", "minLength": 1 },
    "dominantGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title", "workItemId", "agentId", "reason", "truthRefs"],
      "properties": {
        "kind": { "enum": ["decision", "failed_work", "work_item", "deferred_verification", "integration_gate", "none"] },
        "id": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "workItemId": { "type": ["string", "null"] },
        "agentId": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "truthRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "nextAction": { "type": ["string", "null"] },
    "nextActorId": { "type": ["string", "null"] },
    "exitCode": { "const": 0 }
  },
  "examples": [{
    "schemaVersion": "OwlCodaRunKitTeamProjectStatusV1",
    "status": "team_project_status",
    "projectId": "release-017",
    "objective": "Ship OwlRunKit 0.17",
    "overall": "active",
    "counts": {},
    "milestones": [],
    "workstreams": [],
    "workItems": [],
    "agents": [],
    "readyQueue": [],
    "criticalWorkItems": [],
    "openDecisions": [],
    "resolvedDecisions": [],
    "deferredVerifications": [],
    "openDeferredVerificationIds": [],
    "integrationGates": [],
    "dataCandidates": [],
    "projectTruthHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "authorizationGranted": false,
    "headline": "Dominant gap: none; owner: unassigned; blocker: none; next: none.",
    "dominantGap": {
      "kind": "none",
      "id": null,
      "title": null,
      "workItemId": null,
      "agentId": null,
      "reason": null,
      "truthRefs": ["project/definition.json"]
    },
    "nextAction": null,
    "nextActorId": null,
    "exitCode": 0
  }]
}
