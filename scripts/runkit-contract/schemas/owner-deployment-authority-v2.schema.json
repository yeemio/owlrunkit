{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/owner-deployment-authority-v2.json",
  "title": "OwlCoda RunKit Owner Deployment Authority V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityId",
    "decision",
    "scope",
    "executeRunId",
    "prepareReceiptSha256",
    "targetSha256",
    "artifactSha256",
    "remoteManifestFileSha256",
    "remoteDeploymentIntentSha256",
    "ownerDecisionId",
    "ownerDecisionSha256",
    "signerKeyId",
    "signatureAlgorithm",
    "permissions",
    "authorizationGranted",
    "authoritySha256",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "OwlCodaRunKitOwnerDeploymentAuthorityV2"
    },
    "authorityId": { "$ref": "#/$defs/id" },
    "decision": { "const": "approved" },
    "scope": { "const": "execute_exact_remote_deployment" },
    "executeRunId": { "$ref": "#/$defs/id" },
    "prepareReceiptSha256": { "$ref": "#/$defs/digest" },
    "targetSha256": { "$ref": "#/$defs/digest" },
    "artifactSha256": { "$ref": "#/$defs/digest" },
    "remoteManifestFileSha256": { "$ref": "#/$defs/digest" },
    "remoteDeploymentIntentSha256": { "$ref": "#/$defs/digest" },
    "ownerDecisionId": { "$ref": "#/$defs/id" },
    "ownerDecisionSha256": { "$ref": "#/$defs/digest" },
    "signerKeyId": { "$ref": "#/$defs/id" },
    "signatureAlgorithm": { "const": "ed25519" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploy", "destructive"],
      "properties": {
        "deploy": { "const": true },
        "destructive": { "type": "boolean" }
      }
    },
    "authorizationGranted": { "const": false },
    "authoritySha256": { "$ref": "#/$defs/hashRef" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hashRef": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "examples": [{
    "schemaVersion": "OwlCodaRunKitOwnerDeploymentAuthorityV2",
    "authorityId": "owner-deployment-execute-001",
    "decision": "approved",
    "scope": "execute_exact_remote_deployment",
    "executeRunId": "deployment-execute-001",
    "prepareReceiptSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "targetSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "artifactSha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
    "remoteManifestFileSha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
    "remoteDeploymentIntentSha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
    "ownerDecisionId": "owner-clean-install-001",
    "ownerDecisionSha256": "1111111111111111111111111111111111111111111111111111111111111111",
    "signerKeyId": "owner-key-001",
    "signatureAlgorithm": "ed25519",
    "permissions": { "deploy": true, "destructive": false },
    "authorizationGranted": false,
    "authoritySha256": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
    "signature": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="
  }]
}
