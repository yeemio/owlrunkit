{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.com/schemas/runkit/team-project-event-v1.schema.json",
  "title": "OwlCoda RunKit Team Project Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "type", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitTeamProjectEventV1" },
    "eventId": { "$ref": "#/$defs/id" },
    "type": { "enum": ["agent_assigned", "checkpoint_recorded", "handoff_recorded", "decision_opened", "decision_resolved", "integration_gate_passed", "verification_deferred", "verification_closed", "data_candidate_recorded"] },
    "occurredAt": { "type": "string", "minLength": 24 },
    "assignmentId": { "$ref": "#/$defs/id" },
    "supersedesAssignmentId": { "$ref": "#/$defs/id" },
    "workItemId": { "$ref": "#/$defs/id" },
    "agentId": { "$ref": "#/$defs/id" },
    "executionRunId": { "$ref": "#/$defs/id" },
    "executionWorkItemId": { "$ref": "#/$defs/id" },
    "state": { "enum": ["active", "waiting_dependency", "waiting_decision", "verifying", "ready_to_integrate", "completed", "failed"] },
    "summary": { "type": "string", "minLength": 1 },
    "completedUnits": { "type": "integer", "minimum": 0 },
    "evidenceRefs": { "$ref": "#/$defs/strings" },
    "blockerRefs": { "$ref": "#/$defs/strings" },
    "decisionRefs": { "$ref": "#/$defs/strings" },
    "nextAction": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "sourceFingerprint": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "fromAgentId": { "$ref": "#/$defs/id" },
    "toAgentId": { "$ref": "#/$defs/id" },
    "decisionId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "ownerAgentId": { "$ref": "#/$defs/id" },
    "blockingWorkItemIds": { "$ref": "#/$defs/strings" },
    "options": { "$ref": "#/$defs/strings" },
    "resolution": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "gateId": { "$ref": "#/$defs/id" },
    "verificationId": { "$ref": "#/$defs/id" },
    "checkIds": { "$ref": "#/$defs/ids" },
    "reason": { "type": "string", "minLength": 1 },
    "dueGateId": { "$ref": "#/$defs/id" },
    "disposition": { "enum": ["verified", "no_longer_required"] },
    "decisionIds": { "$ref": "#/$defs/ids" },
    "candidateId": { "$ref": "#/$defs/id" },
    "sourceRef": { "type": "string", "minLength": 1 },
    "rights": { "type": "string", "minLength": 1 },
    "inputRef": { "type": "string", "minLength": 1 },
    "outputRef": { "type": "string", "minLength": 1 },
    "decisionRef": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "verificationRefs": { "$ref": "#/$defs/strings" },
    "outcomeRef": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "version": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "agent_assigned" } }, "required": ["type"] },
      "then": {
        "required": ["assignmentId", "workItemId", "agentId"],
        "dependentRequired": {
          "executionRunId": ["executionWorkItemId"],
          "executionWorkItemId": ["executionRunId"]
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "checkpoint_recorded" } }, "required": ["type"] },
      "then": { "required": ["assignmentId", "workItemId", "state", "summary", "evidenceRefs", "blockerRefs", "decisionRefs", "nextAction"] }
    },
    {
      "if": { "properties": { "type": { "const": "handoff_recorded" } }, "required": ["type"] },
      "then": { "required": ["assignmentId", "workItemId", "fromAgentId", "toAgentId", "summary", "evidenceRefs", "nextAction"] }
    },
    {
      "if": { "properties": { "type": { "const": "decision_opened" } }, "required": ["type"] },
      "then": { "required": ["decisionId", "title", "question", "ownerAgentId", "blockingWorkItemIds", "options"] }
    },
    {
      "if": { "properties": { "type": { "const": "decision_resolved" } }, "required": ["type"] },
      "then": { "required": ["decisionId", "resolution", "rationale", "evidenceRefs"] }
    },
    {
      "if": { "properties": { "type": { "const": "integration_gate_passed" } }, "required": ["type"] },
      "then": { "required": ["gateId", "summary", "evidenceRefs"] }
    },
    {
      "if": { "properties": { "type": { "const": "verification_deferred" } }, "required": ["type"] },
      "then": { "required": ["verificationId", "workItemId", "ownerAgentId", "checkIds", "reason", "dueGateId"] }
    },
    {
      "if": { "properties": { "type": { "const": "verification_closed" } }, "required": ["type"] },
      "then": { "required": ["verificationId", "disposition", "summary", "evidenceRefs", "decisionIds"] }
    },
    {
      "if": { "properties": { "type": { "const": "data_candidate_recorded" } }, "required": ["type"] },
      "then": { "required": ["candidateId", "sourceRef", "rights", "inputRef", "outputRef", "decisionRef", "verificationRefs", "outcomeRef", "version"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "examples": [{
    "schemaVersion": "OwlCodaRunKitTeamProjectEventV1",
    "eventId": "event-001",
    "type": "agent_assigned",
    "occurredAt": "2026-08-08T00:00:00.000Z",
    "assignmentId": "assignment-001",
    "workItemId": "engine",
    "agentId": "agent-runtime",
    "executionRunId": "formal-engine-001",
    "executionWorkItemId": "delivery"
  }]
}
