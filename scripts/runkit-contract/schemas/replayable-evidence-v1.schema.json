{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/replayable-evidence-v1.json",
  "title": "OwlCoda RunKit Replayable Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "cwd", "launcher", "toolVersions", "materialInputs", "outputArtifacts"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitReplayableEvidenceV1" },
    "kind": { "enum": ["shell", "automation"] },
    "cwd": { "type": "string", "minLength": 1 },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "version"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "automationManifestSha256": { "$ref": "#/$defs/sha256" },
    "toolVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "materialInputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/idHash" }
    },
    "outputArtifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathHash" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "shell" } } },
      "then": { "required": ["argv"] }
    },
    {
      "if": { "properties": { "kind": { "const": "automation" } } },
      "then": {
        "required": ["automationManifestSha256"],
        "properties": { "outputArtifacts": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
