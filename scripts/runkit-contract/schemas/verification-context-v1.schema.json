{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/verification-context-v1.json",
  "title": "OwlCoda RunKit Verification Context V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reusePolicy", "platform", "toolchains", "lockfiles", "fixtures", "services", "environment"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitVerificationContextV1" },
    "reusePolicy": { "enum": ["portable", "platform_bound", "environment_bound"] },
    "platform": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch"],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "toolchains": {
      "type": "array",
      "items": { "$ref": "#/$defs/nameVersion" }
    },
    "lockfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathHash" }
    },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/idHash" }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "identity"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "identity": { "type": "string", "minLength": 1 }
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "valueSha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "valueSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nameVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "idHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
