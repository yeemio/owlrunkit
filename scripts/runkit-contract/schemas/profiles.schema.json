{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/profiles-v1.json",
  "title": "OwlCoda RunKit Profiles V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitProfilesV1" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "role": { "enum": ["primary", "supporting"] },
          "primary": { "type": "boolean" },
          "requiresProfileIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "cwd", "executable", "argv"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "cwd": { "type": "string", "minLength": 1 },
                "executable": { "type": "string", "minLength": 1 },
                "argv": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
