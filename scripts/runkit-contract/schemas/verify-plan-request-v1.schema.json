{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/verify-plan-request-v1.json",
  "title": "OwlCoda RunKit Verify Plan Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "deliveryPacketPath",
    "statusMode",
    "dependencies",
    "verificationContext",
    "coverageIndexPath",
    "coverageIndexSha256",
    "globalGates"
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitVerifyPlanRequestV1" },
    "planId": { "type": "string", "minLength": 1 },
    "deliveryPacketPath": { "type": "string", "minLength": 1 },
    "statusMode": { "const": "porcelain-v1-z-untracked-all-runkit-excluded" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "baselineSha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "baselineSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "verificationContext": { "$ref": "verification-context-v1.schema.json" },
    "coverageIndexPath": { "type": "string", "minLength": 1 },
    "coverageIndexSha256": { "$ref": "#/$defs/sha256" },
    "globalGates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
