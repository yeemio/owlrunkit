{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/visual-smoke-request-v1.json",
  "title": "OwlCoda RunKit Visual Smoke Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "smokeId", "mode", "targetRoot", "cwd", "executable", "argv", "launcherVersion", "toolVersions", "selectedPaths", "statusMode", "verificationContext", "resultPath", "automationManifest"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitVisualSmokeRequestV1" },
    "smokeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "mode": { "enum": ["project", "foreign_readonly"] },
    "targetRoot": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "executable": { "type": "string", "minLength": 1 },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "launcherVersion": { "type": "string", "minLength": 1 },
    "toolVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "selectedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "statusMode": { "const": "porcelain-v1-z-untracked-all-runkit-excluded" },
    "verificationContext": { "$ref": "verification-context-v1.schema.json" },
    "resultPath": { "type": "string", "minLength": 1 },
    "automationManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "surface", "viewport", "assertionIds", "consolePolicy", "externalNavigationPolicy"],
      "properties": {
        "schemaVersion": { "const": "OwlCodaRunKitVisualAutomationManifestV1" },
        "surface": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "assertionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" } },
        "consolePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxErrors", "maxWarnings", "maxExceptions"],
          "properties": {
            "maxErrors": { "type": "integer", "minimum": 0 },
            "maxWarnings": { "type": "integer", "minimum": 0 },
            "maxExceptions": { "type": "integer", "minimum": 0 }
          }
        },
        "externalNavigationPolicy": { "const": "deny" }
      }
    }
  }
}
