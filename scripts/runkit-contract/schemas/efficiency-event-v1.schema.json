{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/efficiency-event-v1.json",
  "title": "OwlCoda RunKit Efficiency Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "kind",
    "occurredAt",
    "workflowId",
    "summary",
    "evidenceRefs",
    "authorizationGranted"
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitEfficiencyEventV1" },
    "eventId": { "$ref": "#/$defs/id" },
    "kind": {
      "enum": [
        "workflow_started",
        "false_block_confirmed",
        "manual_intervention",
        "acceptable_result_reached"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "workflowId": { "$ref": "#/$defs/id" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "authorizationGranted": { "const": false }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  },
  "examples": [{
    "schemaVersion": "OwlCodaRunKitEfficiencyEventV1",
    "eventId": "workflow-start-001",
    "kind": "workflow_started",
    "occurredAt": "2026-08-13T00:00:00.000Z",
    "workflowId": "wave-001",
    "summary": "The bounded workflow started.",
    "evidenceRefs": [],
    "authorizationGranted": false
  }]
}
