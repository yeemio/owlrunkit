{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/verification-receipt-v2.json",
  "title": "OwlCoda RunKit Verification Receipt V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "receiptId", "status", "sourceFingerprint", "verificationContextFingerprint", "selectedProfileIds", "commandRuns", "commandReceipts"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitVerificationReceiptV2" },
    "runId": { "type": "string", "minLength": 1 },
    "receiptId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "ready_for_verification", "shadow_validated", "invalidated_by_concurrent_write"] },
    "sourceFingerprint": { "$ref": "#/$defs/sha256" },
    "verificationContextFingerprint": { "$ref": "#/$defs/sha256" },
    "goalContractSha256": { "$ref": "#/$defs/sha256" },
    "sourceArtifact": { "$ref": "#/$defs/sourceArtifact" },
    "risk": { "$ref": "#/$defs/risk" },
    "selectedProfileIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "commandRuns": { "type": "integer", "minimum": 0 },
    "supersedesReceiptSha256": { "$ref": "#/$defs/sha256" },
    "commandReceipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandReceipt" }
    },
    "repairControl": {
      "$ref": "#/$defs/repairControl"
    }
  },
  "allOf": [
    {
      "if": { "required": ["supersedesReceiptSha256"] },
      "then": {
        "required": ["repairControl", "goalContractSha256", "risk"]
      }
    },
    {
      "if": { "required": ["repairControl"] },
      "then": {
        "required": ["supersedesReceiptSha256", "goalContractSha256", "risk"]
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runId", "path", "sha256", "sourceFingerprint"],
      "properties": {
        "kind": { "enum": ["delivery_packet_v1", "source_candidate_v2"] },
        "runId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sourceFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "commandReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence", "exitCode", "stdoutSha256", "stderrSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "replayable-evidence-v1.schema.json" },
        "exitCode": { "type": "integer" },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stderrSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "repairControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repairPlanPath",
        "repairPlanSha256",
        "parentBindingMode",
        "goalContractSha256",
        "risk",
        "profilesSha256",
        "executableBindings"
      ],
      "properties": {
        "repairPlanPath": { "type": "string", "minLength": 1 },
        "repairPlanSha256": { "$ref": "#/$defs/sha256" },
        "parentBindingMode": { "const": "receipt" },
        "goalContractSha256": { "$ref": "#/$defs/sha256" },
        "risk": { "$ref": "#/$defs/risk" },
        "profilesSha256": { "$ref": "#/$defs/sha256" },
        "executableBindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/executableBinding" }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskMode", "riskCategories"],
      "properties": {
        "riskMode": { "enum": ["lightweight", "standard", "full"] },
        "riskCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "backtest",
              "funds",
              "migration",
              "production",
              "release"
            ]
          }
        }
      }
    },
    "executableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "executable", "sha256"],
      "properties": {
        "commandId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "executable": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
