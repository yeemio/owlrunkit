{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/evidence-coverage-index-v1.json",
  "title": "OwlCoda RunKit Evidence Coverage Index V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coverageId",
    "runId",
    "generatedFrom",
    "entries",
    "authorizationGranted"
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitEvidenceCoverageIndexV1" },
    "coverageId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "generatedFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateInputPath",
          "gateInputSha256",
          "commandBindings",
          "dependencyBindings",
          "activeReceiptSha256",
          "sourceRunId"
        ],
        "properties": {
          "gateInputPath": { "type": "string", "minLength": 1 },
          "gateInputSha256": { "$ref": "#/$defs/sha256" },
          "commandBindings": { "$ref": "#/$defs/commandBindings" },
          "dependencyBindings": { "$ref": "#/$defs/dependencyBindings" },
          "activeReceiptSha256": { "$ref": "#/$defs/sha256" },
          "sourceRunId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receiptId",
          "receiptSha256",
          "status",
          "sourceFiles",
          "dependencySha256",
          "verificationContextFingerprint",
          "profileIds",
          "commandIds"
        ],
        "properties": {
          "receiptId": { "type": "string", "minLength": 1 },
          "receiptSha256": { "$ref": "#/$defs/sha256" },
          "status": {
            "enum": [
              "passed",
              "ready_for_verification",
              "shadow_validated",
              "invalidated_by_concurrent_write"
            ]
          },
          "sourceFiles": { "$ref": "#/$defs/fileMap" },
          "dependencySha256": { "$ref": "#/$defs/hashMap" },
          "verificationContextFingerprint": { "$ref": "#/$defs/sha256" },
          "profileIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "commandIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "authorizationGranted": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commandBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receiptCommandId", "profileId", "commandId"],
        "properties": {
          "receiptCommandId": { "type": "string", "minLength": 1 },
          "profileId": { "type": "string", "minLength": 1 },
          "commandId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependencyBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependencyId", "source"],
        "properties": {
          "dependencyId": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "identity"],
            "properties": {
              "kind": { "enum": ["lockfile", "fixture", "material_input"] },
              "identity": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "fileMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "hashMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    }
  }
}
