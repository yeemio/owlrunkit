{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/fleet-root-registry-v1.json",
  "title": "OwlCoda RunKit Fleet Root Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "coverageRoots",
    "authorizationGranted",
    "registrySha256"
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitFleetRootRegistryV1" },
    "coverageRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorizationGranted": { "const": false },
    "registrySha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "examples": [{
    "schemaVersion": "OwlCodaRunKitFleetRootRegistryV1",
    "coverageRoots": ["/absolute/path/to/fleet"],
    "authorizationGranted": false,
    "registrySha256": "sha256:270e2fb1accb0e5a891f697c5a483b52881289849cfb75b4cd54a0443bcac8ec"
  }]
}
