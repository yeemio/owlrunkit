{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/ready-for-commit-v2.json",
  "title": "OwlCoda RunKit Ready For Commit Request V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verificationGateInputPath", "roots"],
  "oneOf": [
    {
      "required": ["deliveryPacketPath"],
      "not": { "required": ["sourceCandidatePath"] }
    },
    {
      "required": ["sourceCandidatePath"],
      "not": { "required": ["deliveryPacketPath"] }
    }
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitReadyForCommitRequestV2" },
    "deliveryPacketPath": { "type": "string", "minLength": 1 },
    "sourceCandidatePath": { "type": "string", "minLength": 1 },
    "verificationGateInputPath": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "snapshotPath"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "snapshotPath": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
