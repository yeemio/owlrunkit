{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/coverage-adopt-request-v1.json",
  "title": "OwlCoda RunKit Coverage Adopt Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "coverageId", "sources"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitCoverageAdoptRequestV1" },
    "coverageId": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateInputPath",
          "gateInputSha256",
          "commandBindings",
          "dependencyBindings"
        ],
        "properties": {
          "gateInputPath": { "type": "string", "minLength": 1 },
          "gateInputSha256": { "$ref": "#/$defs/sha256" },
          "commandBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["receiptCommandId", "profileId", "commandId"],
              "properties": {
                "receiptCommandId": { "type": "string", "minLength": 1 },
                "profileId": { "type": "string", "minLength": 1 },
                "commandId": { "type": "string", "minLength": 1 }
              }
            }
          },
          "dependencyBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dependencyId", "source"],
              "properties": {
                "dependencyId": { "type": "string", "minLength": 1 },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "identity"],
                  "properties": {
                    "kind": { "enum": ["lockfile", "fixture", "material_input"] },
                    "identity": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
