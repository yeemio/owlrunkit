{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/ready-for-commit-v1.json",
  "title": "OwlCoda RunKit Ready For Commit Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deliveryPacketPath", "verificationGateInputPath", "roots"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitReadyForCommitRequestV1" },
    "deliveryPacketPath": { "type": "string", "minLength": 1 },
    "verificationGateInputPath": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "snapshotPath"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "snapshotPath": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
