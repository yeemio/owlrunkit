{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/fleet-manifest-v1.json",
  "title": "OwlCoda RunKit Fleet Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skillName", "workspaceRoots", "authorizationGranted"],
  "properties": {
    "schemaVersion": { "const": "OwlCodaRunKitFleetManifestV1" },
    "skillName": { "const": "owlcoda-runkit" },
    "workspaceRoots": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authorizationGranted": { "const": false }
  },
  "examples": [{
    "schemaVersion": "OwlCodaRunKitFleetManifestV1",
    "skillName": "owlcoda-runkit",
    "workspaceRoots": ["/absolute/path/to/project"],
    "authorizationGranted": false
  }]
}
