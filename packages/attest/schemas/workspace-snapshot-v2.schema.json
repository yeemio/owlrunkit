{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/trust/workspace-snapshot-v2.schema.json",
  "title": "OwlCoda Workspace Snapshot V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryIdentity",
    "headCommit",
    "trackedTreeIdentity",
    "submodules",
    "dirtyOverlay",
    "dependencyLockfiles",
    "excludedRoots",
    "ignoredPathsBound",
    "ignoredPathBindings",
    "ignoredPathsFingerprint",
    "sourceStateFingerprint",
    "policyVersion",
    "sourceFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "OwlCodaWorkspaceSnapshotV2" },
    "repositoryIdentity": { "type": "string", "minLength": 1 },
    "headCommit": {
      "type": ["string", "null"],
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "trackedTreeIdentity": { "$ref": "#/$defs/hash" },
    "submodules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "commit"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        }
      }
    },
    "dirtyOverlay": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "state", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "state": { "enum": ["modified", "untracked", "deleted"] },
          "sha256": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/hash" }
            ]
          }
        }
      }
    },
    "dependencyLockfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "excludedRoots": {
      "type": "array",
      "minItems": 1,
      "contains": { "const": ".owlcoda/runkit" },
      "items": { "type": "string", "minLength": 1 }
    },
    "ignoredPathsBound": { "const": true },
    "ignoredPathBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "state", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "state": { "enum": ["missing", "file", "directory"] },
          "sha256": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/hash" }
            ]
          }
        }
      }
    },
    "ignoredPathsFingerprint": { "$ref": "#/$defs/hash" },
    "sourceStateFingerprint": { "$ref": "#/$defs/hash" },
    "policyVersion": { "const": "workspace-snapshot-v2" },
    "sourceFingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
