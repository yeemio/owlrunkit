{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/trust/offline-attestation-bundle-v1.schema.json",
  "title": "OwlCoda Offline Attestation Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reference",
    "receiptByteLength",
    "receiptBytesBase64"
  ],
  "properties": {
    "schemaVersion": {
      "const": "OwlCodaOfflineAttestationBundleV1"
    },
    "reference": {
      "$ref": "attestation-ref-v1.schema.json"
    },
    "receiptByteLength": {
      "type": "integer",
      "minimum": 1
    },
    "receiptBytesBase64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
