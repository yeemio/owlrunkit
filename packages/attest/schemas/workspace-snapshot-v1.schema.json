{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owlcoda.dev/schemas/runkit/trust/workspace-snapshot-v1.schema.json",
  "title": "OwlCoda Workspace Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryIdentity",
    "headCommit",
    "trackedTreeIdentity",
    "submodules",
    "dirtyOverlay",
    "dependencyLockfiles",
    "excludedRoots",
    "ignoredPathsBound",
    "policyVersion",
    "sourceFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "OwlCodaWorkspaceSnapshotV1"
    },
    "repositoryIdentity": {
      "type": "string",
      "minLength": 1
    },
    "headCommit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "trackedTreeIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "submodules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "commit"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        }
      }
    },
    "dirtyOverlay": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "state",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "modified",
              "untracked",
              "deleted"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "dependencyLockfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "excludedRoots": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "const": ".owlcoda/runkit"
      },
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ignoredPathsBound": {
      "const": false
    },
    "policyVersion": {
      "const": "workspace-snapshot-v1"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
